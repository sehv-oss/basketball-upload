{
  "name": "@sehv-oss/dnd-basketball",
  "version": "0.0.0",
  "description": "Basketball-themed drag and drop file upload Web Component: drop your files, or take the shot.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/dnd-basketball.d.ts",
      "default": "./dist/dnd-basketball.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.tests.json && tsdown"
  },
  "files": [
    "./dist",
    "NOTICE.md"
  ],
  "keywords": [
    "file-upload",
    "upload",
    "dropzone",
    "drag-and-drop",
    "dnd",
    "basketball",
    "web-component",
    "custom-element"
  ],
  "license": "ISC",
  "contributors": [
    {
      "name": "Jorge Molina",
      "url": "https://github.com/jm-fuster"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sehv-oss/dnd-basketball.git",
    "directory": "packages/core"
  },
  "homepage": "https://sehv-oss.github.io/dnd-basketball/",
  "bugs": {
    "url": "https://github.com/sehv-oss/dnd-basketball/issues"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "devDependencies": {
    "@sehv-oss/typescript-config": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}

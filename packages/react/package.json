{
  "name": "@sehv-oss/dnd-basketball-react",
  "version": "0.0.0",
  "description": "React component for <dnd-basketball>, the basketball-themed drag and drop file upload.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/dnd-basketball-react.d.ts",
      "default": "./dist/dnd-basketball-react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.tests.json && tsdown"
  },
  "files": [
    "./dist",
    "NOTICE.md"
  ],
  "keywords": [
    "react",
    "file-upload",
    "upload",
    "dropzone",
    "drag-and-drop",
    "dnd",
    "basketball",
    "web-component"
  ],
  "license": "ISC",
  "contributors": [
    {
      "name": "Jorge Molina",
      "url": "https://github.com/jm-fuster"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sehv-oss/dnd-basketball.git",
    "directory": "packages/react"
  },
  "homepage": "https://sehv-oss.github.io/dnd-basketball/",
  "bugs": {
    "url": "https://github.com/sehv-oss/dnd-basketball/issues"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "dependencies": {
    "@sehv-oss/dnd-basketball": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@sehv-oss/typescript-config": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
